# Illustration prompts are included in the published site by default.
# Set to false to strip them from the generated index at build time.
PUBLISH_PROMPTS=true

# Size in pixels for the thumbnail variant (used in gallery grid)
THUMBNAIL_SIZE=200

# Size in pixels for the display variant (used in detail panel)
DISPLAY_SIZE=512

# Size in pixels for the download variant offered to users
DOWNLOAD_SIZE=512
